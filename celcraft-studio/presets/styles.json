{
  "_doc": "Style profiles: default brushes for line art + shading conventions + filmic post chain. Apply with scene.style = '<name>'. Scene-level and frame-level `post` override these values.",
  "anime_cel": {
    "description": "Crisp G-pen line, hard-edged two-tone cel shadows, light bloom and grain.",
    "palette": "anime_cel",
    "line": { "brush": "gpen", "size": 4.0, "color": "@line", "thinning": 0.62, "taper_start": 0.18, "taper_end": 0.3 },
    "detail_line": { "brush": "gpen", "size": 2.2, "color": "@line" },
    "shade": { "blend": "multiply", "opacity": 0.55, "color": "@shadow" },
    "rim": { "blend": "screen", "opacity": 0.8, "color": "@rim" },
    "post": {
      "grain": { "amount": 0.06, "size": 1.0 },
      "vignette": { "amount": 0.22, "inner": 0.5 },
      "bloom": { "strength": 0.18, "radius": 18, "threshold": 0.72 },
      "grade": { "contrast": 1.05, "saturation": 1.08 }
    }
  },
  "ghibli_warm": {
    "description": "Soft pencil line, painterly shading, warm paper and gentle grain.",
    "palette": "ghibli_warm",
    "line": { "brush": "pencil", "size": 3.2, "color": "@line", "thinning": 0.35 },
    "detail_line": { "brush": "pencil", "size": 2.0, "color": "@line_soft" },
    "shade": { "blend": "multiply", "opacity": 0.4, "color": "@shadow" },
    "rim": { "blend": "soft-light", "opacity": 0.7, "color": "@rim" },
    "post": {
      "paper": { "amount": 0.35, "scale": 1.0 },
      "grain": { "amount": 0.05, "size": 1.2 },
      "vignette": { "amount": 0.18, "inner": 0.55 },
      "grade": { "contrast": 0.98, "saturation": 0.95, "tint": "#ffcf8a", "tint_amount": 0.12 }
    }
  },
  "noir_ink": {
    "description": "Heavy brush-pen ink, monochrome grade, strong grain and vignette.",
    "palette": "noir_ink",
    "line": { "brush": "ink", "size": 6.0, "color": "@line", "thinning": 0.85, "taper_start": 0.3, "taper_end": 0.45 },
    "detail_line": { "brush": "ink", "size": 3.0, "color": "@line" },
    "shade": { "blend": "multiply", "opacity": 0.85, "color": "@shadow" },
    "rim": { "blend": "screen", "opacity": 0.9, "color": "@rim" },
    "post": {
      "grain": { "amount": 0.14, "size": 1.4 },
      "vignette": { "amount": 0.5, "inner": 0.35 },
      "grade": { "contrast": 1.3, "saturation": 0.0 },
      "paper": { "amount": 0.2 }
    }
  },
  "neon_sakuga": {
    "description": "Sharp ink, strong glow/bloom, chromatic aberration, saturated night grade.",
    "palette": "neon_sakuga",
    "line": { "brush": "ink", "size": 4.0, "color": "@line", "thinning": 0.75 },
    "detail_line": { "brush": "gpen", "size": 2.0, "color": "@line" },
    "shade": { "blend": "multiply", "opacity": 0.7, "color": "@shadow" },
    "rim": { "blend": "add", "opacity": 0.9, "color": "@rim" },
    "post": {
      "bloom": { "strength": 0.45, "radius": 26, "threshold": 0.6 },
      "chromatic_aberration": { "px": 2 },
      "grain": { "amount": 0.08 },
      "vignette": { "amount": 0.35 },
      "grade": { "contrast": 1.1, "saturation": 1.25 }
    }
  },
  "cartoon_pop": {
    "description": "Thick uniform outline, flat colour, almost no post-processing.",
    "palette": "cartoon_pop",
    "line": { "brush": "gpen", "size": 6.0, "color": "@line", "thinning": 0.25, "taper_start": 0.05, "taper_end": 0.08 },
    "detail_line": { "brush": "gpen", "size": 3.5, "color": "@line", "thinning": 0.2 },
    "shade": { "blend": "multiply", "opacity": 0.35, "color": "@shadow" },
    "rim": { "blend": "screen", "opacity": 0.6, "color": "@rim" },
    "post": {
      "grade": { "saturation": 1.1 }
    }
  }
}
